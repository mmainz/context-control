{
  "name": "context-control",
  "version": "0.1.0",
  "description": "Pi extension for selecting which AGENTS.md files and skills are active per repository.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.11",
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-control",
    "agents",
    "skills"
  ],
  "main": "./index.ts",
  "types": "./index.ts",
  "files": [
    "config.ts",
    "filtering.ts",
    "index.ts",
    "repo-id.ts",
    "report.ts",
    "resource-id.ts",
    "resources.ts",
    "runtime.ts",
    "system-prompt.ts",
    "types.ts",
    "ui.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^3.2.4"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
